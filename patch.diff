+impl<'s, T, const N: usize> IntoV8<'s> for [T; N]
+where
+    T: IntoV8<'s>,
+{
+    fn into_v8(self, scope: &mut v8::PinScope<'s, '_>) -> Result<v8::Local<'s, v8::Value>, NeptuneError> {
+        let array = v8::Array::new(scope, N as i32);
+        for (i, item) in self.into_iter().enumerate() {
+            let v8_item = item.into_v8(scope)?;
+            array.set_index(scope, i as u32, v8_item);
+        }
+        Ok(array.into())
+    }
+}
