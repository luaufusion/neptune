+impl<'s, T, const N: usize> FromV8<'s> for [T; N]
+where
+    T: FromV8<'s>,
+{
+    fn from_v8(scope: &mut v8::PinScope<'s, '_>, value: v8::Local<'s, v8::Value>) -> Result<Self, NeptuneError> {
+        if !value.is_array() {
+            return Err(NeptuneError::StaticTypeError("Expected an array"));
+        }
+        let array = v8::Local::<v8::Array>::try_from(value).unwrap();
+        if array.length() != N as u32 {
+            return Err(NeptuneError::StaticTypeError("Array length mismatch"));
+        }
+        
+        let mut vec = Vec::with_capacity(N);
+        for i in 0..N as u32 {
+            let elem = array.get_index(scope, i).unwrap();
+            vec.push(T::from_v8(scope, elem)?);
+        }
+        
+        vec.try_into().map_err(|_| NeptuneError::StaticTypeError("Failed to convert array"))
+    }
+}
